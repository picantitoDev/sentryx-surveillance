# Configuración del backend de Valentino. No copiar credenciales al frontend público.
SENTRIX_PREDICTOR=videomae
SENTRIX_PROVIDER=cuda
SENTRIX_VIDEO_TRANSPORT=livekit

# Completar con los valores acordados con Gabriel y Mari.
LIVEKIT_URL=
LIVEKIT_ROOM=
LIVEKIT_PARTICIPANT_IDENTITY=
LIVEKIT_SOURCE_ID=

# Identidad propia del suscriptor de inferencia, distinta del emisor y de Mari.
LIVEKIT_BACKEND_IDENTITY=sentrix-inference

# Elegir UNA opción: token privado de solo suscripción o API key + secret.
LIVEKIT_TOKEN=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

TA2_QUEUE_SIZE=2

# Opcional: ruta del archivo SQLite; por defecto backend/data/detections.sqlite3.
SENTRIX_DETECTION_DB=

# Opcional: logs operativos persistentes; por defecto backend/data/inference_logs.sqlite3.
SENTRIX_LOG_DB=

# EN-4: thresholds provisionales por clase (JSON). Vacío usa .50/.60/.60/.55.
# SENTRIX_ALERT_THRESHOLDS={"Hurto":0.50,"Robo":0.60,"Agresión física":0.60,"Vandalismo":0.55}
SENTRIX_ALERT_THRESHOLDS=

# Orígenes permitidos si el navegador consulta directamente la API.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Conexión principal: detecciones, alertas, logs y usuarios en PostgreSQL.
SENTRIX_DATABASE_URL=postgresql://sentrix_app:CAMBIAR@127.0.0.1:55432/sentrix
