# Configuración del backend de Valentino. No copiar credenciales al frontend público.
SENTRIX_PREDICTOR=videomae
SENTRIX_PROVIDER=cuda
SENTRIX_VIDEO_TRANSPORT=rtsp

# Servidor activo de Gabriel; ID del panel y ruta MediaMTX son distintos.
SENTRIX_SOURCE_ID=camara1
SENTRIX_CAMERA_NAME=Gabriel
SENTRIX_STREAM_PATH=camera01
SENTRIX_RTSP_PROTOCOL=rtsp
SENTRIX_RTSP_HOST=184.194.94.182
SENTRIX_RTSP_PORT=8554
SENTRIX_RTSP_USER=viewer

# La clave de control debe coincidir con INFERENCE_API_KEY en SvelteKit.
SENTRIX_CONTROL_API_KEY=

# Solo completar si se configura otro servidor con autenticacion o RTSPS.
SENTRIX_RTSP_PASSWORD=
SENTRIX_RTSP_SHA256=

TA2_QUEUE_SIZE=2

# Opcional: ruta del archivo SQLite; por defecto backend/data/detections.sqlite3.
SENTRIX_DETECTION_DB=

# Opcional: logs operativos persistentes; por defecto backend/data/inference_logs.sqlite3.
SENTRIX_LOG_DB=

# EN-4: thresholds provisionales por clase (JSON). Vacío usa .50/.60/.60/.55.
# SENTRIX_ALERT_THRESHOLDS={"Hurto":0.50,"Robo":0.60,"Agresión física":0.60,"Vandalismo":0.55}
SENTRIX_ALERT_THRESHOLDS=

# Orígenes permitidos si el navegador consulta directamente la API.

# Conexión principal: detecciones, alertas, logs en PostgreSQL.
SENTRIX_DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST/neondb?sslmode=require&channel_binding=require
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://sentrix-vercel-upload.vercel.app
