# URL del servicio FastAPI de inferencia. No colocar credenciales reales aquí.
INFERENCE_API_URL=http://HOST_DE_INFERENCIA:8000

# Clave compartida con el backend. Sustituir únicamente en el archivo .env local.
INFERENCE_API_KEY=REEMPLAZAR_CON_CLAVE_LOCAL

# URL pública de reproducción proporcionada por MediaMTX.
CAMERA_PLAYBACK_URL=http://HOST_DE_MEDIAMTX:8889/RUTA_DE_CAMARA/
