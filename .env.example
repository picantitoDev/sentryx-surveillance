# Servidor local
HOST=127.0.0.1
PORT=5173
ORIGIN=http://127.0.0.1:5173

# Para acceso mediante Tailscale, cambiar ORIGIN por la URL HTTPS del frontend.

# Conexion privada con LiveKit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# API del servidor de inferencia
INFERENCE_API_BASE_URL=

# Clientes generales preparados; opcionales para el flujo actual
PUBLIC_API_BASE_URL=
PUBLIC_WS_URL=

# Registro local; por defecto data/cameras.json
# CAMERA_STORE_PATH=
