{
	"name": "centinela-camaras",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"start": "vite dev",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "npm run test:unit && npm run test:black-box",
		"test:unit": "node --test tests/unit/**/*.test.js",
		"test:black-box": "node --test --test-concurrency=1 tests/black-box/**/*.test.js",
		"test:integration": "node --env-file=.env --test --test-concurrency=1 tests/integration/**/*.test.js",
		"test:e2e": "node --env-file=.env --test --test-concurrency=1 tests/e2e/**/*.test.js",
		"test:all": "npm test && npm run test:integration && npm run test:e2e",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^26.6.5",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#domain/*": "./src/domain/*",
		"#application/*": "./src/application/*",
		"#infrastructure/*": "./src/infrastructure/*",
		"#presentation/*": "./src/presentation/*"
	}
}
